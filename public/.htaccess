# Sirius — seguridad básica (Apache / HostGator)
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "same-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

# Fuerza HTTPS (el sitio ya tiene SSL en HostGator).
# - X-Forwarded-Proto: si algún proxy termina el TLS, no se entra en un bucle de redirecciones.
# - .well-known: la renovación automática del certificado (AutoSSL) valida por HTTP y no debe redirigirse.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
