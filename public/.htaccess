# Sirius — seguridad básica (Apache / HostGator)
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "same-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

# El callback de OAuth de Google (google_oauth.php?code=...&state=...) trae
# parámetros que algunas reglas genéricas de ModSecurity del hosting confunden
# con un ataque y bloquean con "406 Not Acceptable" antes de que le toque a
# PHP procesarlos. Se desactiva ModSecurity solo para este archivo.
<IfModule mod_security.c>
  <Files "google_oauth.php">
    SecRuleEngine Off
  </Files>
</IfModule>
<IfModule mod_security2.c>
  <Files "google_oauth.php">
    SecRuleEngine Off
  </Files>
</IfModule>

# En producción con SSL activo, descomentar para forzar HTTPS:
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
