# Los archivos subidos NUNCA deben ejecutarse como código.
php_flag engine off

<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .shtml
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
  AddType text/plain .php .phtml .phar .cgi .pl .py .shtml .html .htm
</IfModule>

<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|py|shtml|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
